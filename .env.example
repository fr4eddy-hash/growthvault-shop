# ══════════════════════════════════════════════
# GrowthVault — Environment Variables
# Copy this file to .env.local and fill in values
# In Vercel: add all these under Project → Settings → Environment Variables
# ══════════════════════════════════════════════

# ── STRIPE ──────────────────────────────────────
# Get from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_live_...
STRIPE_PUBLISHABLE_KEY=pk_live_...

# Get from: https://dashboard.stripe.com/webhooks
# Endpoint URL: https://YOUR-APP.vercel.app/api/webhook
STRIPE_WEBHOOK_SECRET=whsec_...

# ── VERCEL BLOB ──────────────────────────────────
# Auto-generated when you add Vercel Blob storage in Vercel dashboard
# Project → Storage → Create Database → Blob → Connect
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...

# ── RESEND (Email) ───────────────────────────────
# Get from: https://resend.com/api-keys (free: 3,000 emails/month)
# OPTIONAL — if not set, email delivery is skipped (on-page only)
RESEND_API_KEY=re_...

# ── APP ─────────────────────────────────────────
# Your Vercel app URL (update after first deploy)
NEXT_PUBLIC_APP_URL=https://growthvault.vercel.app

# From email address (must be verified in Resend)
# For free tier: use onboarding@resend.dev
FROM_EMAIL=hello@growthvault.co
FROM_NAME=GrowthVault

# ── PDF BLOB URLs ─────────────────────────────────
# Generated by: npm run upload-pdfs
# Paste the output values here AND in Vercel env vars
BLOB_URL_AI_PLAYBOOK=
BLOB_URL_FREELANCER_FINANCE=
BLOB_URL_SMALL_BIZ_AI=
BLOB_URL_LOCAL_MARKETING=
BLOB_URL_REMOTE_JOBS=
BLOB_URL_WELLNESS_50=
BLOB_URL_NOTION_OS=
BLOB_URL_ETSY_GUIDE=
BLOB_URL_HOMEOWNER_GUIDE=
BLOB_URL_CAREER_PIVOT=
